{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": [],
    "strict": true,
    "skipLibCheck": false,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@octanejs/grab": ["./src/index.ts"],
      "@octanejs/grab/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "tests", "upstream", "upstream-artifact", "audit"],
  "reactPortEvidence": {
    "gate": "authored-source-types"
  }
}
